# =====================================================================
# متغيرات بيئة متجر أبو بشار ستورز
# انسخ هذا الملف إلى .env.local (للتطوير) أو أضِف المتغيرات في Vercel
# Project Settings → Environment Variables (للإنتاج/المعاينة).
# =====================================================================

# عنوان مشروع Supabase (يظهر في Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# المفتاح العام (anon key) — آمن للظهور في المتصفح لأنه محمي بـ RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# (اختياري) رابط أساسي مخصص إذا كان المتجر على نطاق فرعي أو دومين مخصص
# NEXT_PUBLIC_SITE_URL=https://store.abubashar.ye

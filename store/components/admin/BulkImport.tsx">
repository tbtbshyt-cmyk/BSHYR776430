'use client';

import { useRef, useState } from 'react';
import { Upload, Loader2, X, FileSpreadsheet, Download, AlertTriangle } from 'lucide-react';
import { bulkImportProducts, parseImportFile } from '@/lib/demo-store';

const CSV_TEMPLATE = 'title,price,compare_at_price,stock,category,sizes,barcode,image,description,featured,active';

export function BulkImport({ onDone }: { onDone: () => void }) {
  const fileRef = useRef<HTMLInputElement>(null);
  const [busy, setBusy] = useState(false);
  const [result, setResult] = useState<number | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [warnings, setWarnings] = useState<string[]>([]);

  const handle = async (file: File) => {
    setBusy(true);
    setError(null);
    setWarnings([]);
    setResult(null);
    try {
      if (file.size > 15 * 1024 * 1024) {
        setError('حجم الملف كبير جداً (الحد الأقصى 15 ميجابايت)');
        return;
      }
      const rows = await parseImportFile(file);
      if (rows.length === 0) {
        setError('الملف فارغ أو غير صالح. استخدم ملف Excel/CSV/JSON يحتوي على رؤوس أعمدة.');
        return;
      }
      const { imported, errors } = bulkImportProducts(rows);
      if (errors.length) setWarnings(errors.slice(0, 10));
      setResult(imported);
      if (onDone) onDone();
    } catch (e: any) {
      setError(e?.message ?? 'فشل الاستيراد. تأكد من صحة الملف وحاول مجدداً.');
    } finally {
      setBusy(false);
    }
  };

  return (
    <div className="card p-5">
      <h3 className="mb-2 flex items-center gap-2 font-bold">
        <FileSpreadsheet size={18} className="text-gold-400" /> استيراد منتجات بالجملة
      </h3>
      <p className="mb-3 text-xs leading-6 text-stone-400">
        ارفع ملف <strong>Excel (.xlsx)</strong> أو <strong>CSV</strong> أو <strong>JSON</strong>.
        الأعمدة المدعومة:{' '}
        <code className="text-gold-300" dir="ltr">title, price, category, stock, image, sizes, barcode</code>.
        يدعم حتى 500 منتج. الصور في الملف تقبل روابطاً أو أسماء ملفات.
      </p>

      <input
        ref={fileRef}
        type="file"
        accept=".json,.csv,.xlsx,.xls,application/json,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
        hidden
        onChange={(e) => e.target.files?.[0] && handle(e.target.files[0])}
      />
      <div className="flex flex-wrap gap-2">
        <button
          type="button"
          onClick={() => fileRef.current?.click()}
          disabled={busy}
          className="btn-ghost !py-2 text-sm"
        >
          {busy ? <Loader2 size={16} className="animate-spin" /> : <Upload size={16} />}
          اختيار ملف للاستيراد
        </button>

        <a
          href={`data:text/csv;charset=utf-8,${encodeURIComponent(CSV_TEMPLATE + '\n')}`}
          download="products-template.csv"
          className="inline-flex items-center gap-2 rounded-xl border border-gold-400/30 px-4 py-2 text-sm text-gold-300 transition hover:bg-gold-400/10"
        >
          <Download size={16} /> تحميل نموذج CSV
        </a>
      </div>

      {result !== null && (
        <div className="mt-3 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3 text-sm text-emerald-300">
          ✓ تم استيراد <strong>{result}</strong> منتج بنجاح
        </div>
      )}
      {warnings.length > 0 && (
        <div className="mt-3 rounded-xl border border-amber-500/30 bg-amber-500/10 p-3 text-xs text-amber-200">
          <p className="mb-1 flex items-center gap-1 font-bold">
            <AlertTriangle size={14} /> تحذيرات أثناء الاستيراد:
          </p>
          <ul className="list-disc space-y-0.5 pr-4">
            {warnings.map((w, i) => (
              <li key={i}>{w}</li>
            ))}
          </ul>
        </div>
      )}
      {error && (
        <p className="mt-3 rounded-lg bg-red-500/10 p-3 text-sm text-red-300">{error}</p>
      )}
    </div>
  );
}
